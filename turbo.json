{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "AMBIENTUI_BASE_PATH",
        "NEXT_PUBLIC_SITE_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        "out/**",
        ".next/**",
        "!.next/cache/**",
        "content/**"
      ]
    },
    "@ambientui/docs#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/DESIGN.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/CLAUDE.md",
        "$TURBO_ROOT$/docs/motion-spec.md",
        "$TURBO_ROOT$/docs/ambient-shell-spec.md",
        "$TURBO_ROOT$/figma/figma-sync.md",
        "$TURBO_ROOT$/registry.json"
      ],
      "outputs": [
        "dist/**",
        "content/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
