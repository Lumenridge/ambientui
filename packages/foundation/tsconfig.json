{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@ambient-ui/ui/*": ["../ui/src/*"],
      "ambientui/*": ["../ambient/src/*"]
    }
  },
  "include": ["."],
  "exclude": [
    "node_modules",
    "dist",
    "tsup.config.ts"
  ]
}
