{
  "name": "@ambientui/foundation",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "The Foundation engine \u2014 the design system's configuration space, compiled to CSS variables at runtime.",
  "exports": {
    ".": {
      "types": "./dist/foundation-context.d.ts",
      "import": "./dist/foundation-context.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "ambientui": "^0.1.0",
    "@ambientui/ui": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "~6",
    "typescript-eslint": "^8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumenridge/ambientui.git",
    "directory": "packages/foundation"
  },
  "homepage": "https://github.com/Lumenridge/ambientui",
  "bugs": "https://github.com/Lumenridge/ambientui/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
