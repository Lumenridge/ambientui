{
  "name": "ambientui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "The ambient layer \u2014 an AI assistant surface that lives above a product rather than inside its component tree.",
  "exports": {
    "./styles/ambient.css": "./src/styles/ambient.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@ambientui/ui": "^0.1.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "~6",
    "typescript-eslint": "^8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumenridge/ambientui.git",
    "directory": "packages/ambient"
  },
  "homepage": "https://github.com/Lumenridge/ambientui",
  "bugs": "https://github.com/Lumenridge/ambientui/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "@paper-design/shaders-react": "^0.0.80",
    "framer-motion": "^13",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@paper-design/shaders-react": {
      "optional": true
    }
  }
}
