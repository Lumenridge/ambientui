{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@ambientui/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["."],
  "exclude": [
    "node_modules",
    "dist",
    "tsup.config.ts",
    // the bare-mount harness: dev-only, never built, never published, and
    // it imports dev tooling the package does not depend on
    "dev"
  ]
}
