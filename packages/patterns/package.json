{
  "name": "@ambient-ui/patterns",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "description": "Promoted product-vocabulary patterns \u2014 components that grew out of the site through governance and ride the Foundation's motion roles.",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@ambient-ui/foundation": "^0.1.3",
    "@ambient-ui/ui": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^13",
    "globals": "^17",
    "tsup": "^8.5.1",
    "typescript": "~6",
    "typescript-eslint": "^8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumenridge/ambientui.git",
    "directory": "packages/patterns"
  },
  "homepage": "https://ambientui.ai",
  "bugs": "https://github.com/Lumenridge/ambientui/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "framer-motion": "^13"
  },
  "sideEffects": false,
  "keywords": [
    "react",
    "components",
    "navigation",
    "settings",
    "framer-motion",
    "design-system"
  ]
}
