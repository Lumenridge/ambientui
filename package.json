{
  "name": "ambientui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "gate": "npm run catalog:check && npm run docs:sync:check && npm run prerender:check && npm run theme:check && npm run registry:check && npm run vendor:check && npm run docs:check && turbo typecheck lint build && npm run roots:check && npm run css:check && npm run html:check",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "registry:build": "node scripts/build-registry.mjs && shadcn build --output apps/site/public/r",
    "catalog:check": "node scripts/check-catalog.mjs",
    "prerender:check": "node scripts/check-prerender.mjs",
    "theme:check": "node scripts/check-theme-boot.mjs",
    "docs:sync:check": "node scripts/check-system-docs.mjs",
    "html:check": "node scripts/check-static-html.mjs",
    "css:check": "node scripts/check-css-surface.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "vendor:check": "node scripts/check-vendored-css.mjs",
    "roots:check": "node scripts/check-package-roots.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "verify:install:quick": "node scripts/verify-install.mjs --quick",
    "release": "turbo build && changeset publish",
    "docs:check": "node scripts/check-doc-paths.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
