{
  "name": "ambientui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "gate": "npm run catalog:check && npm run prerender:check && npm run registry:check && npm run vendor:check && npm run docs:check && turbo typecheck lint build && npm run roots:check && npm run tokens:check && npm run css:check",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "registry:build": "node scripts/build-registry.mjs && shadcn build --output registry-dist/r && node scripts/build-registry.mjs --finalize registry-dist",
    "catalog:check": "node scripts/extract-catalog.mjs",
    "prerender:check": "node scripts/check-prerender.mjs",
    "css:check": "node scripts/check-css-surface-lib.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "vendor:check": "node scripts/check-vendored-css.mjs",
    "roots:check": "node scripts/check-package-roots.mjs",
    "tokens:check": "node scripts/check-tokens-json.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "verify:install:quick": "node scripts/verify-install.mjs --quick",
    "release": "turbo build && changeset publish",
    "docs:check": "node scripts/check-doc-paths.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^10",
      "onFail": "warn"
    }
  }
}
